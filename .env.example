# OKX Onchain OS
OKX_API_KEY="your-okx-api-key"
OKX_SECRET_KEY="your-okx-secret-key"
OKX_PASSPHRASE="your-okx-passphrase"

# Receiving Wallet (created via createWallet.js)
RECEIVING_WALLET_ADDRESS="0x...generated address"
RECEIVING_WALLET_PRIVATE_KEY="0x...generated private key"

# Railway PostgreSQL
DATABASE_URL="postgresql://user:pass@host:port/dbname"

# Server
PORT=3001
